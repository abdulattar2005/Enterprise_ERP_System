<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.erp</groupId>
    <artifactId>erp-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Enterprise ERP System</name>
    <description>Modular-monolith ERP: HR, Inventory, Accounting, Sales, Reporting</description>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.3.0</springdoc.version>
    </properties>

    <modules>
        <module>erp-core</module>
        <module>erp-hr</module>
        <module>erp-inventory</module>
        <module>erp-accounting</module>
        <module>erp-sales</module>
        <module>erp-reporting</module>
        <module>erp-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.erp</groupId><artifactId>erp-core</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.erp</groupId><artifactId>erp-hr</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.erp</groupId><artifactId>erp-inventory</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.erp</groupId><artifactId>erp-accounting</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.erp</groupId><artifactId>erp-sales</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.erp</groupId><artifactId>erp-reporting</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>
</project>
